{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xr-regulaatio-botti",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Tietopohja kootaan YAML-tiedostoista ennen jokaista julkaisua.
  "build": { "command": "node scripts/build-kb.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Enintään 10 kysymystä minuutissa IP-osoitetta kohden.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // Salaisuus ANTHROPIC_API_KEY lisätään Cloudflaren hallintapaneelissa, ei tähän tiedostoon.
}
